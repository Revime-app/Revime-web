{
  "expo": {
    "name": "Revime",
    "slug": "repareme",
    "scheme": "revime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Revime a besoin d'accéder à vos photos pour illustrer vos demandes de réparation.",
          "cameraPermission": "Revime a besoin d'accéder à votre appareil photo pour vérifier votre pièce d'identité.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/revime_notification.wav",
            "./assets/sounds/revime_message.wav",
            "./assets/sounds/revime_offre_recue.wav",
            "./assets/sounds/revime_offre_acceptee.wav",
            "./assets/sounds/revime_litige.wav"
          ]
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true,
          "merchantIdentifier": "merchant.fr.revime.app"
        }
      ],
      "./plugins/withStripeIdentityAndroid.js",
      "./plugins/withLightAlertDialogAndroid.js",
      "@sentry/react-native"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "fr.revime.demo",
      "infoPlist": {
        "NSCameraUsageDescription": "Revime a besoin d'accéder à votre appareil photo pour vérifier votre pièce d'identité."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "fr.revime.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "applePayMerchantId": "merchant.fr.revime.app",
      "router": {},
      "eas": {
        "projectId": "94c2c182-7fc7-471d-a16f-2021a11013b5"
      }
    },
    "owner": "elaunchit"
  }
}
