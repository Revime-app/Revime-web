# revime.fr - copy to .env and fill in. Real values live in the Vercel project settings.

# The API the site proxies /api/* to (Better Auth + REST). Production: https://api.revime.fr
API_URL=https://api.revime.fr

# Canonical origin used for canonical links, sitemap and JSON-LD.
# Production: https://revime.fr. On a Vercel preview, set it to the preview URL.
NEXT_PUBLIC_SITE_URL=https://revime.fr

# Umami Cloud (cookieless audience measurement). Leave empty to send nothing.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: only if Umami is self-hosted later.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
