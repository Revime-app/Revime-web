PORT=3000
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google and Apple sign-in, 2026-08-20. Apple needs only the bundle id, which is
# the same for both the clientId and appBundleIdentifier: no client secret, no .p8
# key, no Team ID, no Key ID. The ID-token path verifies against Apple's public JWKS.
APPLE_CLIENT_ID=fr.revime.demo
# V9 U3: the client's Sign in with Apple key, used ONLY to revoke an Apple sign-in at account deletion
# (sign-in itself still needs none of these). All three blank = the revocation is skipped and logged.
# 🛑 APPLE_PRIVATE_KEY is the .p8 file's PEM on one line with \n escapes: a secret, never committed.
APPLE_TEAM_ID=B53DSP22UV
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# One origin, or several comma-separated (all trusted; the first goes into e-mail links).
ADMIN_ORIGIN=http://localhost:3001
MAIL_DRIVER=console
RESEND_API_KEY=
VERIFICATION_GATE_ENABLED=false
IDENTITY_GATE_ENABLED=false
# V7 U2b: ask the app for the password (or a code) before an IBAN change or account deletion.
# Stays false on Render until the end-of-round build reaches the client (render.yaml says why).
STEP_UP_ENFORCED=false
# V9 U3: an account linked to Apple or Google confirms with its provider, never an e-mailed code, and
# deleting it needs that confirmation. Stays false on Render until the V9 build reaches users.
STEP_UP_PROVIDER_ENFORCED=false
# V7 D5 (U9): refuse non-staff requests with 503 MAINTENANCE while the dashboard's maintenance mode
# is on. Stays false on Render until the end-of-round build reaches users (render.yaml says why).
PLATFORM_GATES_ENFORCED=false
# V7 U1: optional, the storage bucket for « Mon entreprise » documents. Left commented on purpose:
# the code reads it with `??`, so an EMPTY value would name the bucket '' instead of the default.
# BUSINESS_DOCUMENT_BUCKET=business-documents
PAYMENTS_ENABLED=false
# REQUIRED for local work and for the integration suite, and note the INVERSION:
# absence selects the REAL government company registry, not a fake. Every other
# driver here fails safe to a fake because there the fake sends nothing; for the
# registry the fake is the dangerous direction, since it would grant a real
# « Professionnel verifie » badge on a company nobody verified. So the real one is
# the default and the fake is opt-in.
REGISTRY_DRIVER=fake
STRIPE_DRIVER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:3000

# Added 2026-08-20. This file was missing SIX keys that later slices introduced,
# which is a real cost rather than untidiness: isConnectEnabled() presence-checks
# STRIPE_CONNECT_WEBHOOK_SECRET (connect/config.ts:25), and its absence here made
# CONNECT_ENABLED=true silently read as OFF while every value looked correct.
CONNECT_ENABLED=false
# Etape 5 piece 1. Gates the two messaging WRITES only; the read stamp is open.
MESSAGING_ENABLED=false
# THREE separate endpoints, so three separate secrets. Each is returned by Stripe
# only at creation. isConnectEnabled() needs the CONNECT one present or it is OFF.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# console prints the OTP to this terminal, so local work needs no phone and spends
# nothing. twilio additionally needs all four TWILIO_ values below.
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# P4. Absent means the colis label notification logs loudly instead of sending,
# which is the deliberate local state. Caution: with MAIL_DRIVER != resend AND
# this set, both parties' addresses and phones are written to the log verbatim.
OPS_EMAIL=
# P5. A credential, not a flag. Absent means POST /internal/cron/run REFUSES.
CRON_SECRET=

# Demande photos. Absence selects the FAKE gateway, which writes nothing and reaches no
# network -- the same convention as STRIPE_DRIVER and SMS_DRIVER. Set STORAGE_DRIVER only
# when you actually want real objects created; setting the credentials alone is not enough,
# deliberately, so that a developer trying a real upload does not make the whole integration
# suite start writing to the bucket.
STORAGE_DRIVER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local Stripe TEST MODE, for walking pay -> track -> release in the real app:
#   STRIPE_DRIVER=stripe
#   STRIPE_SECRET_KEY=sk_test_...        never a live key
#   STRIPE_PUBLISHABLE_KEY=pk_test_...
#   STRIPE_WEBHOOK_SECRET=               from `stripe listen --print-secret`
#   stripe listen --forward-to localhost:<PORT>/api/v1/stripe/webhook
# Prefix every Stripe CLI call with MSYS_NO_PATHCONV=1 under Git Bash, or the
# --forward-to path is rewritten into a Windows path.
# ---------------------------------------------------------------------------

# Livraison Boxtal. Absent or anything but boxtal/fake selects `manual`: the flat 19 € and the
# operator's tracking form, byte-for-byte today's behaviour. `fake` is for the test suite ONLY
# and never enables quoting on its own. boxtal needs the FIVE keys below AND STORAGE_DRIVER set,
# or isShippingQuotesEnabled() reads OFF (fail closed, like PAYMENTS_ENABLED). The two BASE urls
# default to production; set them to the sandbox hosts below to point a local api at boxtal.build.
SHIPPING_DRIVER=fake
# Quotes: the deprecated XML API v1 (its own key pair). Sandbox: https://test.envoimoinscher.com/api/v1
BOXTAL_V1_ACCESS_KEY=
BOXTAL_V1_SECRET_KEY=
BOXTAL_V1_BASE=
# Orders, labels, tracking, relay points: API v3 (its own key pair). Sandbox: https://api.boxtal.build
BOXTAL_V3_ACCESS_KEY=
BOXTAL_V3_SECRET_KEY=
BOXTAL_V3_BASE=
# The webhookSecret given to BOTH subscriptions (DOCUMENT_CREATED, TRACKING_CHANGED); the header is hex.
BOXTAL_WEBHOOK_SECRET=
# The SECOND private bucket, PDF only; the photo bucket refuses PDFs. Created by hand.
SHIPPING_LABEL_BUCKET=shipping-labels
# CF-44 push notifications. Absent or anything but expo/fake selects `console`: every push is
# logged and nothing leaves the process — the deliberate local state. `fake` is for the unit
# suite ONLY. `expo` needs NO credential here: the client's APNs key is uploaded to the Expo
# project (spec §10.3), not to this service. EXPO_ACCESS_TOKEN is optional and unset (spec §12).
PUSH_DRIVER=
EXPO_ACCESS_TOKEN=
