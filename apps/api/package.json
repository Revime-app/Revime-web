  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "prisma migrate deploy && node dist/main",
    "verify-build": "npm run build && node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "test:integration": "vitest run .int.spec.",
    "typecheck": "tsc --noEmit",
    "baseline": "tsx scripts/baseline.ts",
    "clean:test-admins": "tsx scripts/clean-test-admins.ts",
    "clean:demo-reviews": "tsx scripts/clean-demo-reviews.ts",
    "clean:test-data": "tsx scripts/clean-test-data.ts",
    "check:schema-migration": "tsx scripts/check-schema-migration.ts",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
